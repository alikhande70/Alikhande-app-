  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./evaluation-pipeline": {
      "types": "./dist/evaluation-pipeline.d.ts",
      "default": "./dist/evaluation-pipeline.js"
    },
    "./mission-evaluation": {
      "types": "./dist/mission-evaluation.d.ts",
      "default": "./dist/mission-evaluation.js"
    },
    "./outcome-labeling": {
      "types": "./dist/outcome-labeling.d.ts",
