{
  "name": "@keel/desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty",
    "dev": "node --enable-source-maps --experimental-strip-types src/main.ts",
    "start": "node --enable-source-maps dist/main.js",
    "test": "vitest run --exclude '**/*.live.test.ts'",
    "test:integration": "vitest run .integration.test",
    "test:chaos": "vitest run .chaos.test",
    "test:live": "vitest run .live.test"
  },
  "dependencies": {
    "@keel/core": "workspace:*",
    "@keel/contracts": "workspace:*",
    "@fastify/websocket": "^11.2.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.1",
    "pino": "^10.0.0",
    "undici": "^7.17.0",
    "ws": "^8.19.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "fast-check": "^4.1.1"
  }
}
